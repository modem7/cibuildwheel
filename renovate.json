{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>modem7/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update recipe versions from PyPI",
      "managerFilePatterns": [
        "/^recipes/[^/]+/recipe\\.yaml$/"
      ],
      "matchStrings": [
        "name: (?<depName>\\S+)\\nversion: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "borgbackup requires msgpack<=1.2.1, which has no Python 3.15 wheels on PyPI",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "msgpack"
      ],
      "allowedVersions": "<=1.2.1"
    }
  ]
}
